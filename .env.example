# ───────────────────────────────────────────────────────────────────────────
# meshtastic-http-interface — example config
# Serial only. Bot is built in; most settings can be tuned live in the
# Bot → Settings tab once running (DB values win over these env values).
# ───────────────────────────────────────────────────────────────────────────

# ── Meshtastic serial ──────────────────────────────────────────────────────
# USB path to your Meshtastic node (must exist on the Docker host).
# Use a stable by-id path if you have multiple USB devices, e.g.
#   /dev/serial/by-id/usb-Silicon_Labs_CP2102_XXXX-if00-port0
MESHTASTIC_SERIAL_PORT=/dev/ttyACM0

# ── Storage ────────────────────────────────────────────────────────────────
DB_PATH=/app/data/meshtastic.db
BOT_DB_PATH=/app/data/mesh-bot.db

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_PORT=5001

# ── Pushover (optional — used by the Rules engine) ─────────────────────────
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# ── Bot identity & behaviour (initial seed only; edit live in the GUI) ─────
BOT_ENABLED=true
BOT_NAME=MeshBot
# Decimal node id of your connected radio. Find it under Nodes after first
# packet arrives. Required so the bot doesn't reply to its own messages.
BOT_NODE_NUMBER=0

DEFAULT_RESPONSE_CHANNEL=0
COMMAND_PREFIX=/
REQUIRE_PREFIX=false
IGNORED_NODES=
# Minimum seconds between replies to the SAME node. Applied per-node, and a
# message that arrives inside the window is SILENTLY DROPPED (no reply) — so a
# value that's too high looks like "the bot doesn't always reply" during back-
# and-forth. 10 throttles spam while staying conversational; raise for a busy
# mesh, set 0 to disable. (Note: applies to cheap commands like /ping too.)
RATE_LIMIT_SECONDS=10
MAX_RESPONSE_LENGTH=200
DEFAULT_LOCATION=New York

# ── LLM (Ollama) — set LLM_FALLBACK_ENABLED=false to disable AI replies ────
LLM_FALLBACK_ENABLED=true
# Ollama runs as a SEPARATE container, not part of this stack (see
# docs/OLLAMA_SETUP.md). When Ollama runs on the SAME host, attach both
# containers to the shared `mesh-net` network (see docker-compose) and use the
# Ollama container name here. Do NOT use host.docker.internal if your LAN DNS
# owns that name: it resolves to the host's external LAN IP and the
# container->published-port hairpin silently times out. To use Ollama on
# another LAN machine, put its IP here instead.
LLM_HOST=ollama
LLM_PORT=11434
# Keep the model tiny for a 2GB Pi 4 (CPU-only). llama3.2:1b (~1.3GB) fits;
# qwen2.5:1.5b is a fine alternative. Avoid 3B+ models on 2GB.
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT=60
MAX_HISTORY_TURNS=10
HISTORY_TIMEOUT_MINUTES=5
LLM_SYSTEM_PROMPT=You are a helpful assistant responding over a low-bandwidth mesh radio network. Be extremely concise and direct. No introductions, no filler words, just the essential answer.

# ── Weather alert ─────────────────────────────────────────────────────────
WEATHER_ALERT_ENABLED=false
WEATHER_ALERT_HOUR=8
WEATHER_ALERT_TZ=America/Chicago

# ── Custom modules ─────────────────────────────────────────────────────────
SHELL_ALLOWLIST=echo,uptime,date,df,free
ALLOW_PYTHON_MODULES=false
